<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.zzz8688.diagagent.mapper.DiagnosisRecordMapper">

    <resultMap id="DiagnosisRecordResultMap" type="io.github.zzz8688.diagagent.entity.DiagnosisRecord">
        <id property="id" column="id"/>
        <result property="query" column="query"/>
        <result property="conclusion" column="conclusion"/>
        <result property="rootCause" column="root_cause"/>
        <result property="suggestions" column="suggestions"/>
        <result property="confidence" column="confidence"/>
        <result property="engine" column="engine"/>
        <result property="verified" column="verified"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="DiagnosisRecordColumns">
        id, query, conclusion, root_cause, suggestions, confidence, engine, verified, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="io.github.zzz8688.diagagent.entity.DiagnosisRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO diagnosis_record
        (query, conclusion, root_cause, suggestions, confidence, engine, verified, created_at, updated_at)
        VALUES
        (#{query}, #{conclusion}, #{rootCause}, #{suggestions}, #{confidence}, #{engine}, #{verified}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="findRecentRecords" resultMap="DiagnosisRecordResultMap">
        SELECT <include refid="DiagnosisRecordColumns"/>
        FROM diagnosis_record
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <select id="searchByQuery" resultMap="DiagnosisRecordResultMap">
        SELECT <include refid="DiagnosisRecordColumns"/>
        FROM diagnosis_record
        WHERE query LIKE CONCAT('%', #{query}, '%')
           OR conclusion LIKE CONCAT('%', #{query}, '%')
        ORDER BY created_at DESC
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM diagnosis_record
    </select>

    <select id="findByPage" resultMap="DiagnosisRecordResultMap">
        SELECT <include refid="DiagnosisRecordColumns"/>
        FROM diagnosis_record
        ORDER BY created_at DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <delete id="deleteById">
        DELETE FROM diagnosis_record WHERE id = #{id}
    </delete>

    <delete id="deleteAll">
        DELETE FROM diagnosis_record
    </delete>
</mapper>
